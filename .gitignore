!vendor/simc/engine/class_modules/apl/druid/feral_apl.inc
!vendor/simc/engine/dbc/
vendor/simc/engine/dbc/**
!vendor/simc/engine/dbc/generated/
vendor/simc/engine/dbc/generated/**
!vendor/simc/engine/dbc/generated/item_effect.inc
!vendor/simc/engine/dbc/generated/item_set_bonus.inc
!vendor/simc/engine/dbc/generated/sc_spell_data.inc
!vendor/simc/engine/dbc/generated/trait_data.inc
