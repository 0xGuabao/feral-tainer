[Unit]
Description=World of Warcraft Feral Trainer static demo
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/sites/wow-feral-trainer
ExecStart=/usr/bin/python3 /home/ubuntu/releases/wow-feral-trainer/cache_server.py --bind 0.0.0.0 --port 8787 --directory /home/ubuntu/sites/wow-feral-trainer
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
